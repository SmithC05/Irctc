# Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_PATH=./db/nammarail.db

# JWT Authentication
JWT_SECRET=your_super_secret_key_here_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email Notifications (leave empty if not using)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional: Payment Gateway (leave empty if not using)
STRIPE_KEY=
RAZORPAY_KEY=

# Session
SESSION_SECRET=your_session_secret_here
