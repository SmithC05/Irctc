# Environment variables for NammaRail backend
# ─────────────────────────────────────────────
# NEVER commit this file to Git!
# It contains secrets. Add .env to your .gitignore.
# ─────────────────────────────────────────────

# The port the Express server listens on
PORT=5000

# The URL of the React frontend — used by CORS to allow requests
CLIENT_URL=http://localhost:5173

# Secret key used to sign JWT tokens
# Use a long, random string in production — never share this!
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Environment mode — controls things like SQLite verbose logging
NODE_ENV=development
